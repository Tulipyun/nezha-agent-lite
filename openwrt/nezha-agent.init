#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/nezha-agent-lite

start_service() {
    [ -x "$PROG" ] || return 1

    config_load nezha-agent
    config_get server main server ""
    config_get secret main secret ""
    config_get report_delay main report_delay "1"
    config_get workers main workers "8"
    config_get report_workers main report_workers "2"
    config_get queue_capacity main queue_capacity "128"
    config_get task_max_age main task_max_age "30"
    config_get rpc_timeout main rpc_timeout "5"
    config_get_bool debug main debug "0"

    [ -n "$server" ] || {
        logger -t nezha-agent "missing server (host:port) in config section main"
        return 1
    }
    [ -n "$secret" ] || {
        logger -t nezha-agent "missing secret in config section main"
        return 1
    }

    procd_open_instance
    procd_set_param command "$PROG" \
        -s "$server" \
        -p "$secret" \
        --report-delay "$report_delay" \
        --workers "$workers" \
        --report-workers "$report_workers" \
        --queue-capacity "$queue_capacity" \
        --task-max-age "$task_max_age" \
        --rpc-timeout "$rpc_timeout"
    [ "$debug" = "1" ] && procd_append_param command --debug
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "nezha-agent"
}
